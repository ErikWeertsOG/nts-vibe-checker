{
  "manifest_version": 3,
  "name": "NTS Vibe Checker",
  "version": "0.2.0",
  "description": "Toont NTS Vibe-badges op festival-line-ups, op basis van je NTS Vibe Checker-deploy.",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/storage.js", "src/content.js"],
      "css": ["src/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NTS Vibe Checker"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/badge.css"],
      "matches": ["https://*/*"]
    }
  ]
}
